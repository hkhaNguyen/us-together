rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Same access list as Firestore: a members/{email} document.
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.token.email));
    }

    match /photos/{photoId}/{file} {
      allow read: if isMember();
      // Photos are compressed on the device first; anything big or non-image
      // didn't come from the app.
      allow write: if isMember()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
