rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Same access list as Firestore: a members/{email} document.
    match /photos/{file=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.token.email));
    }
  }
}
