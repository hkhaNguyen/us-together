rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // members/{email} documents (each pointing at a people/{id}) are added by
    // hand in the Firebase console; they are the whole access list.
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email));
    }

    match /members/{email} {
      allow read: if isMember();
      allow write: if false;
    }

    match /people/{personId} {
      allow read: if isMember();
      allow write: if false;
    }

    match /{collection}/{id} {
      allow read, write: if isMember()
        && collection in ['moments', 'photos', 'entries', 'anniversaries'];
    }
  }
}
