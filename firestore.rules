rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // members/{email} documents (each pointing at a people/{id}) are added by
    // hand in the Firebase console; they are the whole access list.
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email));
    }

    // The person (people/{id}) the signed-in email belongs to.
    function me() {
      return get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.person;
    }

    match /members/{email} {
      allow read: if isMember();
      allow write: if false;
    }

    // Names and colours are set in the console; each of them may only change
    // their own picture.
    match /people/{personId} {
      allow read: if isMember();
      allow update: if isMember() && personId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl']);
    }

    // Cảm nghĩ: anyone writes their own; only the author edits or deletes.
    match /entries/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.author == me();
      allow update: if isMember() && resource.data.author == me()
        && request.resource.data.author == resource.data.author;
      allow delete: if isMember() && resource.data.author == me();
    }

    match /{collection}/{id} {
      allow read, write: if isMember()
        && collection in ['moments', 'photos', 'anniversaries'];
    }

    // Push tokens: each of them files their own devices; only the
    // functions (admin) ever read them.
    match /tokens/{token} {
      allow create, update: if isMember() && request.resource.data.person == me();
      allow delete: if isMember() && resource.data.person == me();
    }

    // "Tell the other one": written alongside the change itself, read and
    // removed by the functions.
    match /activity/{id} {
      allow create: if isMember() && request.resource.data.by == me();
    }
  }
}
